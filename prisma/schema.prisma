generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROF
  ALUMNO
}

enum Estado {
  PROPUESTO
  APROBADO
  RECHAZADO
}

enum DocTipo {
  PROPUESTA
  PDF_FINAL
  PRESENTACION // NUEVO
  OTRO
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  nombre       String
  passwordHash String?
  role         Role      @default(ALUMNO)
  isActive     Boolean   @default(false)
  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  celular      String?
  dni          String?   @unique
  fechaRindio  DateTime?
  nota         Int?
  egresado     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  proyectos    Proyecto[]  @relation("OwnerProyectos")
  aprobaciones Proyecto[]  @relation("AprobadorProyectos")
  documentos   Documento[] @relation("UploaderDocs")
  logs         AuditLog[]
  materialesSubidos MaterialCatedra[] @relation("UploaderMateriales")
  comentariosProyecto ProyectoComentario[]

  // 👇 Soft-delete + trazabilidad
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("UserDeletedBy", fields: [deletedById], references: [id])
  // 👇 lado inverso (quiénes fueron eliminados por este usuario)
  deletedUsers User[]    @relation("UserDeletedBy")

  // 👇 lado inverso para los logs de eliminación (targetUser)
  auditTargetOf AuditLog[] @relation("AuditTargetUser")
}




model Proyecto {
  id              String   @id @default(cuid())
  titulo          String
  descripcion     String
  funcionalidades String[]
  alumnoNombre    String
  alumnoEmail     String
  anio            Int
  fechaCarga      DateTime
  estado          Estado   @default(PROPUESTO)
  textoIndexado   String
  checksumPdf     String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // NUEVO: flag de actividad (soft-delete)
  isActive        Boolean  @default(true)

  // NUEVO: dueño alumno que creó la propuesta
  ownerId         String   
  owner           User     @relation("OwnerProyectos", fields: [ownerId], references: [id])

  // NUEVO: quién la aprobó y cuándo
  aprobadoPorId   String?
  aprobadoPor     User?    @relation("AprobadorProyectos", fields: [aprobadoPorId], references: [id])
  aprobadoEn      DateTime?

  documentos Documento[]
  logs       AuditLog[]

  comentarios ProyectoComentario[]

}

model Documento {
  id         String   @id @default(cuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId String
  tipo       DocTipo
  url        String
  mime       String
  size       Int
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation("UploaderDocs", fields: [uploadedById], references: [id])

  // ÚNICO por proyecto+tipo+versión (evita duplicados accidentales)
  @@unique([proyectoId, tipo, version])
}

// NUEVO: tabla de auditoría
enum AuditAction {
  CREAR_PROYECTO
  APROBAR_PROYECTO
  RECHAZAR_PROYECTO
  SUBIR_PDF
  EDITAR_PROYECTO
  BORRAR_PROYECTO
  DESCARGAR_PDF
  ELIMINAR_USUARIO           

  // NUEVOS
  CREAR_USUARIO
  APROBAR_USUARIO
  RECHAZAR_USUARIO
  EDITAR_USUARIO
  CAMBIAR_PASSWORD

  // Materiales de cátedra
  SUBIR_MATERIAL
  REEMPLAZAR_MATERIAL
  BORRAR_MATERIAL
  DESCARGAR_MATERIAL

  // Visualización
  VER_PDF

  // Notificaciones
  ENVIAR_EMAIL
}



model AuditLog {
  id           String       @id @default(cuid())
  action       AuditAction
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  proyectoId   String?
  proyecto     Proyecto?    @relation(fields: [proyectoId], references: [id])
  targetUserId String?
  targetUser   User?        @relation("AuditTargetUser", fields: [targetUserId], references: [id])
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([createdAt, action])
  @@index([userId, createdAt])
  @@index([proyectoId, createdAt])
  @@index([targetUserId, createdAt])
}




model MaterialCatedra {
  id          String  @id @default(cuid())
  titulo      String
  descripcion String?
  categoria   String?
  key         String  @unique
  mime        String
  size        Int
  version     Int     @default(1)

  uploadedById String
  uploadedBy   User   @relation("UploaderMateriales", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ComentarioTipo {
  APROBACION
  RECHAZO
  FEEDBACK
}

model ProyectoComentario {
  id         String         @id @default(cuid())
  proyecto   Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId String
  autor      User           @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorId    String
  tipo       ComentarioTipo
  texto      String
  createdAt  DateTime       @default(now())
}
