generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROF
  ALUMNO
}

enum Estado {
  PROPUESTO
  APROBADO
  RECHAZADO
}

enum DocTipo {
  PROPUESTA
  PDF_FINAL
  OTRO
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  passwordHash  String
  role          Role     @default(ALUMNO)
  isActive      Boolean  @default(false)     //  agregado
  requestedAt   DateTime @default(now())     //  agregado (audit)
  approvedAt    DateTime?                    //  agregado (audit)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proyectos    Proyecto[]        @relation("OwnerProyectos")
  aprobaciones Proyecto[]        @relation("AprobadorProyectos")
  documentos   Documento[]       @relation("UploaderDocs")
  logs         AuditLog[]
}

model Proyecto {
  id              String      @id @default(cuid())
  titulo          String
  descripcion     String
  funcionalidades String[]
  alumnoNombre    String
  alumnoEmail     String
  anio            Int
  fechaCarga      DateTime     
  estado          Estado       @default(APROBADO)
  textoIndexado   String
  checksumPdf     String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

    // NUEVO: dueño alumno que creó la propuesta
  ownerId         String
  owner           User        @relation("OwnerProyectos", fields: [ownerId], references: [id])

  // NUEVO: quién la aprobó y cuándo
  aprobadoPorId   String?
  aprobadoPor     User?       @relation("AprobadorProyectos", fields: [aprobadoPorId], references: [id])
  aprobadoEn      DateTime?

  documentos      Documento[]
  logs            AuditLog[]
}

model Documento {
  id         String    @id @default(cuid())
  proyecto   Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId String
  tipo       DocTipo
  url        String
  mime       String
  size       Int
  version    Int       @default(1)
  createdAt  DateTime  @default(now())

  // NUEVO: quién subió el PDF
  uploadedById String
  uploadedBy   User   @relation("UploaderDocs", fields: [uploadedById], references: [id])
}

// NUEVO: tabla de auditoría
enum AuditAction {
  CREAR_PROYECTO
  APROBAR_PROYECTO
  RECHAZAR_PROYECTO
  SUBIR_PDF
  EDITAR_PROYECTO
  BORRAR_PROYECTO
  DESCARGAR_PDF
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  proyectoId String?
  proyecto   Proyecto?   @relation(fields: [proyectoId], references: [id])
  metadata   Json?
  createdAt  DateTime    @default(now())
}